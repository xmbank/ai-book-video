# Existing Douyin capture backend (optional, local path only)
# Example: ./external/obsidian-content-capture-backend
CAPTURE_BACKEND_DIR=
# Optional: a current Douyin cookie string. If omitted, the service reads Chrome's
# local .douyin.com session for share pages that hide SSR item data.
DOUYIN_COOKIE=

# OpenAI-compatible chat completion API used for script rewriting
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible image generation API. Defaults can be overridden per provider.
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536

# Volcengine Doubao speech synthesis 2.0 (API Key mode)
VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts

# Optional paths
WORKBENCH_DATA_DIR=./data
# Optional demo reference video used by `uv run book-video demo`
# Example: ./assets/reference-demo.mp4
REFERENCE_DEMO_VIDEO=
